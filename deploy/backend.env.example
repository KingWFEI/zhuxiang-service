# Copy to /opt/apps/easenest/secrets/backend.env on the test server.
# Keep real values out of Git.
TOKEN_SECRET=replace-with-a-long-random-value

# App-only test login. The fixed verification code is accepted only for this phone
# and only for the login scene. Keep disabled in production.
APP_TEST_USER_ENABLED=true
APP_TEST_USER_ID=00000000-0000-0000-0000-000000000002
APP_TEST_USER_PHONE=13900000000
APP_TEST_USER_NICKNAME=App测试用户
APP_TEST_USER_VERIFICATION_CODE=replace-with-six-digits

# Optional external integrations
STORAGE_TYPE=cos
TENCENT_COS_SECRET_ID=
TENCENT_COS_SECRET_KEY=
TENCENT_COS_REGION=ap-guangzhou
TENCENT_COS_BUCKET=
