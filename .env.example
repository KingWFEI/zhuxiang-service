
# 超级管理员初始化配置（首次创建时手机号、密码、昵称必填）
# 是否在启动时初始化超级管理员
SUPER_ADMIN_ENABLED=true
# 超级管理员登录手机号
SUPER_ADMIN_PHONE=
# 超级管理员初始登录密码
SUPER_ADMIN_PASSWORD=
# 超级管理员显示昵称
SUPER_ADMIN_NICKNAME=超级管理员

# 勿忧管家平台房东初始化配置（启用时 ID、手机号、名称必填）
# 是否在启动时初始化勿忧管家平台房东
PLATFORM_LANDLORD_ENABLED=true
# 勿忧管家系统用户及房东资料共用的固定 ID
PLATFORM_LANDLORD_ID=
# 勿忧管家系统用户的手机号（系统用户不可登录）
PLATFORM_LANDLORD_PHONE=
# 平台房东显示名称
PLATFORM_LANDLORD_NAME=勿忧管家
# 平台房东头像地址，可留空
PLATFORM_LANDLORD_AVATAR_URL=
# 平台房东响应描述，可留空
PLATFORM_LANDLORD_RESPONSE_DESCRIPTION=平台自营房源

# 智能体接口调用密钥，用于验证请求
AGENT_API_KEY=
# 允许的智能体请求来源标识
AGENT_EXPECTED_SOURCE=
# 允许访问智能体接口的来源地址列表，格式按服务端配置要求填写
AGENT_ALLOWED_SOURCE_ADDRESSES=
# Agent 内部业务工具角色权限配置；留空时使用 classpath 默认配置。
AGENT_TOOL_PERMISSIONS_FILE=classpath:agent-tool-permissions.json
# 图片存储方式：local 表示本地存储，cos 表示腾讯云对象存储
STORAGE_TYPE=cos
# 本地存储的公开文件目录；相对路径相对于服务启动目录
LOCAL_STORAGE_DIRECTORY=./uploads
# 本地存储的敏感文件目录；应放在公开目录之外
LOCAL_PRIVATE_STORAGE_DIRECTORY=./uploads-private
# 本地公开文件 URL 路径，不包含 API 前缀
LOCAL_STORAGE_PUBLIC_PATH=/uploads
# 腾讯云对象存储 SecretId
TENCENT_COS_SECRET_ID=
# 腾讯云对象存储 SecretKey
TENCENT_COS_SECRET_KEY=
# 腾讯云对象存储地域，例如 ap-guangzhou
TENCENT_COS_REGION=
# 腾讯云对象存储桶名称
TENCENT_COS_BUCKET=
# 身份证信息加密密钥，需为 Base64 编码且解码后恰好 32 字节
REAL_NAME_ID_CARD_KEY=
# e签宝人脸认证应用 ID
ESIGN_FACE_APP_ID=
# e签宝人脸认证应用密钥
ESIGN_FACE_APP_SECRET=

# e签宝平台企业组织 ID
ESIGN_PLATFORM_ORG_ID=
# e签宝平台经办人个人账号 ID
ESIGN_PLATFORM_TRANSACTOR_PSN_ID=
# e签宝平台企业印章 ID
ESIGN_PLATFORM_SEAL_ID=
# e签宝平台企业名称；未配置组织 ID 时可用于匹配组织
ESIGN_PLATFORM_ORG_NAME=重庆踏山河科技有限公司

# 支付宝应用 ID
ALIPAY_APP_ID=
# 支付宝商户应用私钥
ALIPAY_MERCHANT_PRIVATE_KEY=
# 支付宝平台公钥，用于验签
ALIPAY_ALIPAY_PUBLIC_KEY=
# 支付宝网关地址；默认值为沙箱网关，生产环境请使用正式网关
ALIPAY_GATEWAY_URL=https://openapi-sandbox.dl.alipaydev.com/gateway.do
# 支付宝异步通知地址；部署后应设置为公网可访问的 HTTPS 地址
ALIPAY_NOTIFY_URL=https://你的公网域名/api/payments/alipay/notify
# 支付宝支付完成后的同步返回地址
ALIPAY_RETURN_URL=http://localhost/zhuxiang-payment-done
