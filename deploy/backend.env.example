# Copy to /opt/apps/easenest/secrets/backend.env on the test server.
# Keep real values out of Git.
# 以下变量没有代码默认值，缺失时服务启动失败。
TOKEN_SECRET=replace-with-a-long-random-value
ALIPAY_APP_ID=replace-me
AMAP_WEB_SERVICE_KEY=replace-me
TTLOCK_CLIENT_ID=replace-me
TTLOCK_CLIENT_SECRET=replace-me
TTLOCK_USERNAME=replace-me
TTLOCK_PASSWORD=replace-me
ESIGN_APP_ID=replace-me
ESIGN_APP_SECRET=replace-me

# Optional external integrations
STORAGE_TYPE=cos
TENCENT_COS_SECRET_ID=
TENCENT_COS_SECRET_KEY=
TENCENT_COS_REGION=ap-guangzhou
TENCENT_COS_BUCKET=
